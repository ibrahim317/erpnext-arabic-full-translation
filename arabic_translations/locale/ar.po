"\tfieldtype: \"Link\",\n"
"\toptions: \"Company\",\n"
"\tdefault: frappe.defaults.get_user_default(\"Company\"),\n"
"\treqd: 1\n"
"},\n"
"{\n"
"\tfieldname: \"account\",\n"
"\tlabel: __(\"الحساب\"),\n"
"\tfieldtype: \"Link\",\n"
"\toptions: \"Account\",\n"
"\treqd: 1\n"
"}]\n"
